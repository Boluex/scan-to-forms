# Copy to ignored .env.worker, chmod 600, and supply real values privately.
# SCANTO_FORMS_ENV_FILE selects this file for native Python worker commands.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DATABASE_URL=
REDIS_URL=
REDIS_SSL_CA_CERTS=
PROCESSING_MODE=celery
CELERY_TASK_ALWAYS_EAGER=false
ENABLE_LEGACY_WORKSPACE=false
ENABLE_PAYSTACK=false
TEST_DEPLOYMENT=true
OBJECT_STORAGE_ENABLED=true
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_ADDRESSING_STYLE=path
OCR_ENGINE=auto
PADDLEOCR_DEVICE=cpu
PADDLEOCR_LANG=en
OCR_STALE_AFTER_SECONDS=900
