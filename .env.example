# Django
DJANGO_SECRET_KEY=replace-this-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# PostgreSQL (Docker defaults)
POSTGRES_DB=scanforms
POSTGRES_USER=scanforms
POSTGRES_PASSWORD=scanforms_dev_only
DATABASE_URL=postgresql://scanforms:scanforms_dev_only@db:5432/scanforms

# Queue
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# Files and OCR
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=100
OCR_ENGINE=auto
PADDLEOCR_LANG=en
PADDLEOCR_DEVICE=cpu
PADDLE_PDX_CACHE_HOME=.cache/paddlex
MEDIA_ROOT=/app/media

# Paystack (use test keys locally; never expose the secret key to the frontend)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/dashboard/billing/callback
PAYSTACK_STUDENT_MONTHLY_PLAN_CODE=
PAYSTACK_STUDENT_YEARLY_PLAN_CODE=
PAYSTACK_RESEARCHER_MONTHLY_PLAN_CODE=
PAYSTACK_RESEARCHER_YEARLY_PLAN_CODE=
PAYSTACK_ORGANIZATION_MONTHLY_PLAN_CODE=
PAYSTACK_ORGANIZATION_YEARLY_PLAN_CODE=
EXTRA_OCR_PAGES_PRICE_KOBO=150000
ADMIN_CONTACT_EMAIL=admin@localhost
FRONTEND_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Focused two-service MVP (set real values before collecting payment)
ENABLE_LEGACY_WORKSPACE=false
ENABLE_PAYSTACK=false
ENABLE_ORGANIZATIONS=false
ENABLE_PUBLIC_BOTLAB=false
ENABLE_GOOGLE_OAUTH=false
ENABLE_WHATSAPP=false
MANUAL_BANK_TRANSFER_ENABLED=true
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
DIGITIZATION_PRICE_PER_RESPONDENT_NGN=0
SYNTHETIC_PRICE_PER_RESPONSE_NGN=0
PROCESSING_MODE=celery
TEST_DEPLOYMENT=false
MAX_ORDER_RESPONDENTS=1000
MAX_ORDER_PAGES=5000
MAX_SYNTHETIC_RESPONSES=1000
USE_S3_STORAGE=false
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
DJANGO_TRUST_PROXY=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
